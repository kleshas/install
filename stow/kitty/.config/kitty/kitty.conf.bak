# ==============================================================================
# FONTS & TYPOGRAPHY SYSTEM
# ==============================================================================
font_family          JetBrainsMono Nerd Font
bold_font            auto
italic_font          auto
bold_italic_font     auto
font_size            12.0

# ==============================================================================
# MECHANICAL CORE ENGINE PROPERTIES
# ==============================================================================
window_padding_width 12
remember_window_size no
initial_width        960
initial_height       600
confirm_os_window_close 0

# ==============================================================================
# TAB BAR PANEL DESIGN ELEMENTS
# ==============================================================================
tab_bar_style         powerline
active_tab_font_style bold

# ==============================================================================
# EXTERNAL THEME SPECIFIC VARIABLE IMPORT
# ==============================================================================
# This single directive pulls every active color token, interface element text,
# tab highlight state, and panel border framework from your colors file.
# include colors.conf
include themes/matugen.conf



# BEGIN_KITTY_THEME
# Matugen
include matugen.conf
# END_KITTY_THEME

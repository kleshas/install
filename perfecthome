.folder { 
border-style: double;
border-radius: 12px;
border-width: 6px;
margin-top: -20vh;
width: 325px;
height: 1200px;
padding: 0px 0px 0px 0px;
--color-border: var(--color1);
position: fixed;
top: 40px;
transform: none;
margin: 0 0 0 -1px!important; /* margin is set by javascript, so `!important` is needed to overwrite it */
			}

.folder-items { min-height: calc(100vh - 20px); max-height: calc(100vh - 20px); }

